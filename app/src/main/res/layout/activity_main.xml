<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tvNomeJogadorUm"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/ic_jogadorUm"
        android:layout_width="51dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:contentDescription="Logo jogador 1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_jogadorum" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="137dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="20dp"
        android:text="Jogador 1:"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        app:layout_constraintStart_toEndOf="@+id/ic_jogadorUm"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvPontosJogador1"
        android:layout_width="32dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:text="0"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        app:layout_constraintBaseline_toBaselineOf="@+id/textView"
        app:layout_constraintStart_toEndOf="@+id/textView" />

    <Button
        android:id="@+id/btUmPonto"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:maxLines="1"
        android:minWidth="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:text="+1"
        app:layout_constraintEnd_toStartOf="@+id/btTresPontos"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ic_jogadorUm" />

    <Button
        android:id="@+id/btTresPontos"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:maxLines="1"
        android:minWidth="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:text="+3"
        app:layout_constraintEnd_toStartOf="@+id/btSeisPontos"
        app:layout_constraintStart_toEndOf="@+id/btUmPonto"
        app:layout_constraintTop_toBottomOf="@+id/ic_jogadorUm" />

    <Button
        android:id="@+id/btSeisPontos"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:maxLines="1"
        android:minWidth="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:text="+6"
        app:layout_constraintEnd_toStartOf="@+id/btNovePontos"
        app:layout_constraintStart_toEndOf="@+id/btTresPontos"
        app:layout_constraintTop_toBottomOf="@+id/ic_jogadorUm" />

    <Button
        android:id="@+id/btNovePontos"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:maxLines="1"
        android:minWidth="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:text="+9"
        app:layout_constraintEnd_toStartOf="@+id/btDozePontos"
        app:layout_constraintStart_toEndOf="@+id/btSeisPontos"
        app:layout_constraintTop_toBottomOf="@+id/ic_jogadorUm" />

    <Button
        android:id="@+id/btDozePontos"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:maxLines="1"
        android:minWidth="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:text="+12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btNovePontos"
        app:layout_constraintTop_toBottomOf="@+id/ic_jogadorUm" />

    <ImageView
        android:id="@+id/ic_jogadorDois"
        android:layout_width="51dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:contentDescription="Logo jogador 2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btDozePontos"
        app:srcCompat="@drawable/ic_jogadorum" />

    <TextView
        android:id="@+id/tvJogadorDois"
        android:layout_width="134dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="24dp"
        android:text="Jogador 2:"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/ic_jogadorDois"
        app:layout_constraintTop_toBottomOf="@+id/btDozePontos" />

    <TextView
        android:id="@+id/tvPontosJogador2"
        android:layout_width="32dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="24dp"
        android:text="0"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvJogadorDois"
        app:layout_constraintStart_toEndOf="@+id/tvJogadorDois" />

    <Button
        android:id="@+id/btUmPonto2"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:maxLines="1"
        android:minWidth="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:text="+1"
        app:layout_constraintEnd_toStartOf="@+id/btTresPontos2"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ic_jogadorDois" />

    <Button
        android:id="@+id/btTresPontos2"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:maxLines="1"
        android:minWidth="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:text="+3"
        app:layout_constraintEnd_toStartOf="@+id/btSeisPontos2"
        app:layout_constraintStart_toEndOf="@+id/btUmPonto2"
        app:layout_constraintTop_toBottomOf="@+id/ic_jogadorDois" />

    <Button
        android:id="@+id/btSeisPontos2"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:maxLines="1"
        android:minWidth="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:text="+6"
        app:layout_constraintEnd_toStartOf="@+id/btNovePontos2"
        app:layout_constraintStart_toEndOf="@+id/btTresPontos2"
        app:layout_constraintTop_toBottomOf="@+id/ic_jogadorDois" />

    <Button
        android:id="@+id/btNovePontos2"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:maxLines="1"
        android:minWidth="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:text="+9"
        app:layout_constraintEnd_toStartOf="@+id/btDozePontos2"
        app:layout_constraintStart_toEndOf="@+id/btSeisPontos2"
        app:layout_constraintTop_toBottomOf="@+id/ic_jogadorDois" />

    <Button
        android:id="@+id/btDozePontos2"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:maxLines="1"
        android:minWidth="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:text="+12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btNovePontos2"
        app:layout_constraintTop_toBottomOf="@+id/ic_jogadorDois" />

    <Button
        android:id="@+id/btJogadas"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:text="Hist. de jogadas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btDozePontos2" />

    <Button
        android:id="@+id/btZerarHistorico2"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="Zerar historico"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btJogadas" />

    <Button
        android:id="@+id/btZerarHistorico"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="inf. Nomes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btZerarHistorico2" />

</androidx.constraintlayout.widget.ConstraintLayout>
